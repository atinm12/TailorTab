{
  "manifest_version": 3,
  "name": "TailorTab",
  "version": "1.0.0",
  "description": "AI-powered personal dashboard that replaces your new tab page",
  "chrome_url_overrides": { "newtab": "index.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' https://cdn.pendo.io; object-src 'self'"
  },
  "host_permissions": [
    "https://site.api.espn.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://news.google.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://smart-homepage-api.tailortab.workers.dev/*",
    "https://cdn.pendo.io/*",
    "https://app.pendo.io/*",
    "https://pendo-io-static.storage.googleapis.com/*",
    "http://localhost:8787/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
